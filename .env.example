# CORVO environment variables (copy to `.env` for your own notes; the API reads the PROCESS
# environment only and does NOT load .env files automatically in M0).
# In PowerShell:  $env:CORVO_REGION_DIR = "C:\path\to\regions"; npm run dev:api

# Directory with real region packs (<region_id>.json). A real pack overrides the MOCK pack of
# the same id. Default (unset): <repo>/data/regions
# CORVO_REGION_DIR=

# Optional: python executable used by the npm scripts (tools/py.mjs). Default: active venv,
# then `py -3` (Windows) / `python3` (macOS, Linux).
# CORVO_PYTHON=

# --- PLANNED, NOT READ BY ANY CODE YET (M1+/M7 data probes) --------------------------------
# NASA Earthdata token for CMR/HLS/NISAR access. Never commit a real value.
# EARTHDATA_TOKEN=
