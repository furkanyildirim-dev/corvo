          "title": "Schema Version",
          "type": "string"
        },
        "site": {
          "$ref": "#/$defs/SiteGeometry"
        },
        "soils": {
          "$ref": "#/$defs/SoilSet"
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "description",
        "site",
        "parcels",
        "soils",
        "climate",
        "crops",
        "rules",
        "observation_layers"
      ],
      "title": "RegionPack",
      "type": "object"
    },
