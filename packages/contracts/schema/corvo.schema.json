    },
    "SeasonSummary": {
      "additionalProperties": false,
      "properties": {
        "crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crop Id"
        },
        "et_total_mm": {
          "minimum": 0,
          "title": "Et Total Mm",
          "type": "number"
        },
        "irrigation_total_mm": {
          "minimum": 0,
