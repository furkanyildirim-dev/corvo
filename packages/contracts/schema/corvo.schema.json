          "$ref": "#/$defs/CropCatalog"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "observation_layers": {
          "items": {
            "$ref": "#/$defs/ObservationLayerSpec"
          },
          "title": "Observation Layers",
          "type": "array"
        },
        "parcels": {
          "$ref": "#/$defs/ParcelSet"
        },
        "rules": {
          "$ref": "#/$defs/ResourceRules"
        },
        "schema_version": {
          "const": "0.1.0",
