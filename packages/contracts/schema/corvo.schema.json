    "SimDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "day": {
          "minimum": 0,
          "title": "Day",
          "type": "integer"
        },
        "parcels": {
          "items": {
            "$ref": "#/$defs/ParcelDayState"
          },
          "title": "Parcels",
          "type": "array"
        }
      },
